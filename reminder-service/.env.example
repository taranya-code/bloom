# ADK model (src/reminder-service/agent.py). Needs credentials for whichever
# provider google-adk resolves to (GOOGLE_API_KEY for AI Studio, or GCP
# application-default credentials for Vertex).
ADK_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=

# If "1", the first reminder fires ~45s after a schedule change instead of
# waiting for the real dose-time slot — useful for demos.
DEMO_MODE=0

# Public URL of this service, used in the A2A agent card at /.well-known/agent.json
SERVICE_URL=http://localhost:8080

PORT=8080

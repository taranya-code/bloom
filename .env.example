# === Model provider (src/mastra/provider.ts) ===
# Default: Google AI Studio. Get a key at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# Set MODEL_PROVIDER=vertex to switch to Vertex AI (production).
# Requires GOOGLE_APPLICATION_CREDENTIALS or workload identity in the deploy env.
MODEL_PROVIDER=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1

# === Qdrant (src/mastra/qdrant.ts) — grounded retrieval ===
# Defaults to local Qdrant on http://localhost:6333.
# Leave unset if running: docker run -d -p 6333:6333 qdrant/qdrant
# Set both if using Qdrant Cloud instead.
QDRANT_URL=
QDRANT_API_KEY=

# === Enkrypt (src/mastra/enkrypt.ts) — medical-safety guardrails ===
# Optional; falls back to local regex rules if unset.
ENKRYPT_API_KEY=

# === Persistence (src/mastra/persistence.ts) ===
# Set PERSISTENCE=firestore for durable storage (requires GCP credentials + a Firestore
# database in the project). Anything else uses an in-memory store (local demo only,
# state is lost on restart).
PERSISTENCE=

# === Analytics (src/mastra/analytics.ts) — anonymized BigQuery logging ===
# Optional; logs to console if BQ_DATASET is unset.
BQ_DATASET=
BQ_TABLE=interactions

# === A2A (src/mastra/tools.ts) — notifies the reminder-service on schedule changes ===
# URL of the deployed bloom-reminders (ADK) Cloud Run service, e.g. https://bloom-reminders-xxxx.run.app
REMINDER_SERVICE_URL=

# === Observability (src/mastra/index.ts) ===
# OTLP endpoint for Cloud Trace export. Falls back to console exporter if unset.
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Session (src/mastra/tools.ts) ===
# Overrides the default "default" session id used for medication/followup state.
BLOOM_SESSION=

# === HITL escalation (src/mastra/tools.ts) — human-in-the-loop safety net (FR-5.5) ===
# Webhook URL for the clinical on-call queue. Every RF-1 (escalate) and RF-3 (refer)
# triage verdict POSTs {session, triage_rule_id, escalated_at} here. If unset, or if the
# webhook fails/times out, the event goes to the in-memory dead-letter log (tools.ts,
# `hitlDeadLetterQueue`) instead of being silently dropped -- see NFR-6.2/NFR-6.3.
HITL_WEBHOOK_URL=

# === Secrets in production (docs/PRD.md NFR-9.1) ===
# All of the above are local-dev env vars only. In Cloud Run, none of them should be set
# as plain container env vars for real secrets (API keys, webhook URLs with tokens, DB
# credentials) -- inject them from GCP Secret Manager instead. See docs/secrets.md for
# the exact gcloud commands used at deploy time.
